# Copy this file to .env and fill in the values. Never commit .env.

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection. With docker compose, the app container uses the "db" service automatically.
DATABASE_URL=postgresql://tax_assistant:1234@localhost:5432/tax_database

# Needed only for the "Generate Advice" feature
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
